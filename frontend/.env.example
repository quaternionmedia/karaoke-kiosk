# Karaoke Kiosk frontend — environment configuration.
# Copy to `.env.local` (gitignored) to override locally.

# Backend API origin. Leave empty to use same-origin "/api" requests
# (e.g. when the frontend is served behind a reverse proxy that forwards /api).
VITE_API_BASE_URL=http://localhost:8000

# Use the in-browser fake API instead of a real backend ("true"/"1" to enable).
# Handy for UI work and testing without running the backend.
VITE_DEMO_MODE=false
